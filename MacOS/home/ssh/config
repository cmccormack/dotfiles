# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

Host 192.168.1.26
  HostName 192.168.1.26
  User chris

Host Ubuntu24_VM_MackGamingPC
  HostName Ubuntu24.local
  User chris

Host 192.168.1.25
  HostName 192.168.1.25
  User chris

Host Ubuntu24.local
  HostName Ubuntu24.local
  User chris

Host 192.168.1.184
  HostName 192.168.1.184

Host Mack-NAS.local
  HostName Mack-NAS.local
  User chris

Host MackPi5.local
  HostName MackPi5.local
  User chris

# deckops: warm multiplexed SSH to the Steam Decks. First connection opens a
# master that persists 1h after last use; later ssh/scp/ansible runs reuse it.
Host deck-oled
  HostName 192.168.1.30

Host deck-lcd
  HostName 192.168.1.25

Host deck-oled deck-lcd 192.168.1.30
  User deck

Host deck-oled deck-lcd 192.168.1.30 192.168.1.25
  ControlMaster auto
  ControlPath ~/.ssh/cm/%r@%h-%p
  ControlPersist 1h
  ServerAliveInterval 30

# GitHub: one multiplexed connection reused for 10 min. Bursts of fresh port-22
# connections (multi-repo /git-commit runs) hit connect timeouts after 4 or 5 in a row
# (measured 2026-09-19); a shared master never opens more than one.
Host github.com
  ControlMaster auto
  ControlPath ~/.ssh/cm/%r@%h-%p
  ControlPersist 10m
  ServerAliveInterval 30
